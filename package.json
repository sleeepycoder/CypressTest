{
  "name": "cypresstest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint cypress",
    "lint:fix": "eslint cypress --fix",
    "format": "prettier --write .",
    "test": "cypress run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:report": "cypress run",
    "merge-reports": "mochawesome-merge cypress/reports/mochawesome-report/*.json > cypress/reports/mochawesome-report/mochawesome.json",
    "generate-report": "marge cypress/reports/mochawesome-report/mochawesome.json --reportDir cypress/reports/mochawesome-report --inline",
    "test:report": "npm run cypress:run:report && npm run merge-reports && npm run generate-report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleeepycoder/CypressTest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sleeepycoder/CypressTest/issues"
  },
  "homepage": "https://github.com/sleeepycoder/CypressTest#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "cypress": "^15.19.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "globals": "^17.7.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "faker": "^6.6.6"
  }
}
